# 复制为 local.env 后按本机环境填写；local.env 已被 .gitignore 排除。
# Windows 路径建议写 C:/... 并用单引号包住。

# 必填：Android SDK，需含 build-tools/34.0.0 与 platforms/android-34。
ANDROID_SDK_DIR='/path/to/android-sdk'

# 必填：JDK 17（构建脚本使用 bin/javac、bin/jar、bin/java）。
JAVA_HOME='/path/to/jdk-17'

# 可选：Python 3 命令或解释器路径；缺省 python3。
PYTHON='python3'

# 可选：adb 不在上述 SDK 里时单独指定。
# ADB='/path/to/adb'

# 可选：app/adbw.sh 使用的默认设备序列号。
ADB_SERIAL=''

# 可选：仅曲库在线同步脚本需要；App 本身完全离线，不读取此值。
# MAGIC_PIANO_TOKEN=''
